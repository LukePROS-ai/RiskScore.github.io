{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pai current sensor response v1.0",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "stations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "stations": { "type": "array", "items": { "$ref": "#/$defs/station" } }
  },
  "$defs": {
    "station": {
      "type": "object",
      "required": [
        "id",
        "name",
        "coordinates",
        "area",
        "measurements",
        "timestamp",
        "deviceStatus",
        "demo",
        "coordinateSource"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ]
        },
        "area": {
          "type": "object",
          "required": [
            "provinceId",
            "districtId",
            "subdistrictId",
            "villageId"
          ],
          "properties": {
            "provinceId": { "const": "58" },
            "districtId": { "const": "5803" },
            "subdistrictId": { "type": "string", "pattern": "^58030[1-7]$" },
            "villageId": {
              "anyOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^58030[1-7][0-9]{2}$" }
              ]
            }
          }
        },
        "measurements": {
          "type": "object",
          "required": [
            "pm25",
            "humidity",
            "windSpeed",
            "windDirection",
            "pressure"
          ],
          "properties": {
            "pm25": { "type": ["number", "null"], "minimum": 0 },
            "humidity": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 100
            },
            "windSpeed": { "type": ["number", "null"], "minimum": 0 },
            "windDirection": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 360
            },
            "pressure": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "deviceStatus": { "enum": ["online", "offline", "maintenance"] },
        "demo": { "type": "boolean" },
        "coordinateSource": { "type": "string" }
      }
    }
  }
}
